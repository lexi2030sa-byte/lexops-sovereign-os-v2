"right_to_object": "يحق لمن صدر ضده قرار العقوبة التظلم منه خلال 60 يوماً من تاريخ العلم بالقرار أمام المحاكم الإدارية في ديوان المظالم وفقاً لنظامه"
},
{
"article_id": "24",
"effective_date": "يعمل بهذه القواعد اعتباراً من تاريخ صدورها بقرار من الوزير، وتُبلغ للجهات المختصة للعمل بموجبها"
}
]
}
],
"compliance_rules": [
{
"rule_id": "COM-001",
"source_article": "2",
"description": "تشكيل اللجنة من 6 أعضاء (3 من الجهات ذات العلاقة + 3 من الجهاز البلدي)",
"logic": "committee_members = 6 AND composition = '3_related_entities + 3_municipal_entity'"
},
{
"rule_id": "COM-002",
"source_article": "2",
"description": "نصاب اللجنة: حضور الرئيس مع 3 أعضاء",
"logic": "if attending_members >= 4 AND chairperson_present == true then quorum_met = true"
},
