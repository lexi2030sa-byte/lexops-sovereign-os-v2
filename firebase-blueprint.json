        "id": { "type": "string" },
        "entityId": { "type": "string" },
        "entityName": { "type": "string" },
        "employeeName": { "type": "string" },
        "type": { "type": "string" },
        "details": { "type": "string" },
        "impactLevel": { "type": "string" },
