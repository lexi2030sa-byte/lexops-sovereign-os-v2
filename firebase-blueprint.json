{
  "entities": {
    "SovereignRequest": {
      "title": "SovereignRequest",
      "description": "Onboarding registration request pending founder approval.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "orgName": { "type": "string" },
        "crNumber": { "type": "string" },
        "sector": { "type": "string" },
        "tier": { "type": "string" },
        "nationalId": { "type": "string" },
        "approvedByFounder": { "type": "boolean" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "email", "role", "approvedByFounder"]
    },
    "CrowdsourceEntry": {
