        "markdownContent": { "type": "string" }
      },
      "required": ["id", "citationId", "employeeName", "grounds", "status"]
    },
    "C9Event": {
      "title": "C9Event",
      "description": "Sovereign intelligence ledger blocks tracking regulatory assertions.",
