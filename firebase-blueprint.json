      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "crNumber": { "type": "string" },
        "email": { "type": "string" },
        "sector": { "type": "string" },
        "tier": { "type": "string" },
        "onboardedAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "crNumber", "sector", "tier"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Firms workforce biometric/geofence registered representative.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nationalId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "entityId": { "type": "string" },
        "entityName": { "type": "string" },
        "joinedAt": { "type": "string" }
      },
      "required": ["id", "name", "nationalId", "entityId"]
    },
    "Citation": {
      "title": "Citation",
      "description": "Legal/municipal compliance infraction logged by system sensors.",
      "type": "object",
