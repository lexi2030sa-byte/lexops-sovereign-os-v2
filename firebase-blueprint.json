  "firestore": {
    "/sovereign_clipboards/{clipboardId}": {
      "schema": "SovereignClipboard",
      "description": "Encrypted secure clipboard vault storage database collection"
    },
    "/support_requests/{ticketId}": {
      "schema": "SupportRequest",
      "description": "Support tickets and solutions ledger"
    },
    "/crowdsource_entries/{entryId}": {
      "schema": "CrowdsourceEntry",
      "description": "Crowdsourced feedback on statutory challenges."
    },
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "List of companies regulated by LexOps."
    },
    "/employees/{empId}": {
      "schema": "Employee",
      "description": "Active staff profiles with workforce data links."
    },
    "/citations/{citationId}": {
      "schema": "Citation",
      "description": "Statutory citations and compliance infractions."
    },
    "/appeals/{appealId}": {
      "schema": "Appeal",
      "description": "Infraction objections and regulatory appeals."
    },
    "/c9_events/{eventId}": {
      "schema": "C9Event",
      "description": "C9 blockchain audit timeline ledger events."
    },
    "/requests/{requestId}": {
      "schema": "SovereignRequest",
      "description": "Sovereign onboard registration requests submitted by entities and individuals."
    }
  }
