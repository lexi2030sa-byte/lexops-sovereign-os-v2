import React, { useState, useEffect, useRef } from "react";
import {
  Shield, FileText, CheckCircle2, AlertTriangle, XCircle, Clock,
  Search, Filter, Plus, ChevronDown, Download, Share2, Printer, Eye,
  Lock, Unlock, RefreshCw, Sliders, Database, Server, Cpu, Activity,
  BarChart3, Award, AlertOctagon, Terminal, Key, FileCheck, Gavel,
  Scale, Zap, Hash, Check, Info, HelpCircle, FolderCheck, BookOpen,
  Power, FileCode, CheckCheck, Play, Send, Sparkles
} from "lucide-react";
import { doc, setDoc, collection, onSnapshot, query, where, orderBy, serverTimestamp } from "firebase/firestore";
import { db, auth } from "../lib/firebase";

// --- Types ---
export type DocumentType = 
  | "macro_compliance_report" 
  | "certified_payroll_wps" 
  | "forensic_c9_audit" 
  | "freelance_nda_agreement" 
  | "municipal_health_permit";

export interface Sadedocument {
  id: string;
  strictEntityId: string;
  title: string;
  type: DocumentType;
  generatedAt: string;
  sizeBytes: number;
  status: "sealed" | "verifying" | "warning";
  c9BlockIndex: number;
  c9SignatureHash: string;
  authorizedBy: string;
  metadata: {
    system: string;
    version: string;
    itemsCount: number;
    hashAlgorithm: string;
  };
}

interface SovereignSadeProps {
  lang?: "ar" | "en";
  pushNewC9Event?: (type: string, refId: string, payload: any) => Promise<void> | void;
  c9Events?: any[];
  currentUser?: any;
}

const SovereignAutoDocumentationEngine: React.FC<SovereignSadeProps> = ({ lang = "ar", pushNewC9Event, c9Events = [], currentUser }) => {
  const isAr = lang === "ar";
  const strictEntityId = currentUser?.entityId || auth.currentUser?.uid || "7001002003";

  const [documents, setDocuments] = useState<Sadedocument[]>([]);
  const [activeTypeFilter, setActiveTypeFilter] = useState<string>("all");
  const [searchQuery, setSearchQuery] = useState("");
  const [isGenerating, setIsGenerating] = useState(false);
  const [generationStep, setGenerationStep] = useState(0);
  const [terminalLogs, setTerminalLogs] = useState<string[]>([]);
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  const [newDocTitle, setNewDocTitle] = useState("");
  const [newDocType, setNewDocType] = useState<DocumentType>("macro_compliance_report");
  const [includeC9Verification, setIncludeC9Verification] = useState(true);
  const [customVersion, setCustomVersion] = useState("1.0.0");

  const [verifyHashQuery, setVerifyHashQuery] = useState("");
  const [verificationResult, setVerificationResult] = useState<{
    status: "idle" | "valid" | "invalid";
    docTitle?: string;
    timestamp?: string;
    blockIndex?: number;
  }>({ status: "idle" });

  const terminalEndRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const q = query(
      collection(db, "sade_documents"),
      where("strictEntityId", "==", strictEntityId),
      orderBy("generatedAt", "desc")
    );

    const unsub = onSnapshot(q, (snapshot) => {
      if (!snapshot.empty) {
        const liveDocs = snapshot.docs.map(doc => doc.data() as Sadedocument);
        setDocuments(liveDocs);
      } else {
        setDocuments([]);
      }
    }, (error) => {
      console.warn("Firestore SADE stream error:", error);
    });

    return () => unsub();
  }, [strictEntityId]);

  useEffect(() => {
    terminalEndRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [terminalLogs]);

  const triggerToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 4000);
  };

  const handleVerifyHash = () => {
    if (!verifyHashQuery) {
      triggerToast(isAr ? "يرجى إدخال كود الهاش أو معرّف الوثيقة" : "Please enter a hash or document ID");
      return;
    }
    const q = verifyHashQuery.trim();
    const found = documents.find(d => d.id === q || d.c9SignatureHash === q);
    if (found) {
      setVerificationResult({
        status: "valid",
        docTitle: found.title,
        timestamp: found.generatedAt,
        blockIndex: found.c9BlockIndex
      });
      triggerToast(isAr ? "✅ تم إثبات صحة الوثيقة ومطابقتها لسجل C9" : "✅ Document verified and matched to C9 ledger");
    } else {
      setVerificationResult({ status: "invalid" });
      triggerToast(isAr ? "❌ فشل التحقق! الهاش غير مسجل" : "❌ Verification failed! Hash not found");
    }
  };

  const runGenerationPipeline = async () => {
    if (!newDocTitle) {
      triggerToast(isAr ? "يرجى إدخال عنوان للوثيقة" : "Please enter a document title");
      return;
    }

    setIsGenerating(true);
    setGenerationStep(1);
    setTerminalLogs([]);

    const log = (msg: string) => {
      setTerminalLogs(prev => [...prev, `[${new Date().toLocaleTimeString()}] ${msg}`]);
    };

    await new Promise(r => setTimeout(r, 700));
    log("📡 تهيئة نفق الاتصال الآمن مع خادم الرقابة السيادي S8...");
    log(`🔒 التحقق من جدار الحماية وعزل البيانات للكيان: ${strictEntityId}`);
    log(`👤 تصريح الوصول معتمد للبريد: ${currentUser?.email || auth.currentUser?.email || "sultan2026hr@gmail.com"}`);

    await new Promise(r => setTimeout(r, 900));
    setGenerationStep(2);
    log("📊 جلب الشواهد اللحظية من Google Firestore...");
    log(`🔍 تجميع المتغيرات لمستند نوع: [${newDocType}]`);

    await new Promise(r => setTimeout(r, 1100));
    setGenerationStep(3);
    log("⚙️ استدعاء محرك التصدير المعزول 2026...");

    await new Promise(r => setTimeout(r, 1200));
    setGenerationStep(4);
    log("⛓️ احتساب بصمة البيانات (HMAC-SHA256)...");
    const secureHash = `c9_block_hmac_${Date.now().toString(16)}${Math.random().toString(16).slice(2, 12)}`;
    log(`💎 كود الهاش المتولد: ${secureHash}`);

    await new Promise(r => setTimeout(r, 900));
    setGenerationStep(5);
    log("💾 إيداع الوثيقة في [sade_documents]...");

    const newDocId = `SADE-2026-${Math.floor(10000 + Math.random() * 90000)}`;
    const newDoc: Sadedocument = {
      id: newDocId,
      strictEntityId,
      title: newDocTitle,
      type: newDocType,
      generatedAt: new Date().toISOString(),
      sizeBytes: Math.floor(75000 + Math.random() * 150000),
      status: "sealed",
      c9BlockIndex: documents.length + 115,
      c9SignatureHash: secureHash,
      authorizedBy: currentUser?.email || auth.currentUser?.email || "sultan2026hr@gmail.com",
      metadata: {
        system: newDocType.toUpperCase().replace("_REPORT", ""),
        version: customVersion,
        itemsCount: Math.floor(5 + Math.random() * 50),
        hashAlgorithm: "HMAC-SHA256"
      }
    };

    try {
      await setDoc(doc(db, "sade_documents", newDocId), {
        ...newDoc,
        createdAt: serverTimestamp()
      });
    } catch (e) {
      console.warn("Firestore SADE persistence bypassed:", e);
    }

    setDocuments(prev => [newDoc, ...prev]);
    setIsGenerating(false);
    setNewDocTitle("");
    triggerToast(isAr ? "🎉 تم إصدار التقرير وتثبيته في خزانة الوثائق" : "🎉 Document sealed and archived successfully");
  };

  return (
    <div className="min-h-screen bg-[#080A0F] text-[#E2E8F0] p-4 lg:p-8 font-sans selection:bg-[#D4AF37]/30 selection:text-[#F3E5AB]">
      {toastMessage && (
        <div className="fixed top-6 left-1/2 transform -translate-x-1/2 z-50 sovereign-glass-gold px-6 py-3 rounded-xl border border-[#D4AF37] flex items-center gap-3 shadow-[0_0_25px_rgba(212,175,55,0.25)]">
          <Sparkles className="w-5 h-5 text-[#D4AF37]" />
          <span className="text-sm font-medium text-white">{toastMessage}</span>
        </div>
      )}

      <div className="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-white/5 pb-6">
        <div>
          <div className="flex items-center gap-3 mb-1">
            <div className="p-2 rounded-lg bg-[#D4AF37]/10 border border-[#D4AF37]/20">
              <Cpu className="w-6 h-6 text-[#D4AF37]" />
            </div>
            <h1 className="text-2xl font-bold tracking-tight text-white font-sans">
              {isAr ? "محرك التوثيق والأرشفة المؤتمت السيادي (SADE)" : "Sovereign Auto-Documentation Engine (SADE)"}
            </h1>
          </div>
          <p className="text-sm text-slate-400">
            {isAr ? "نظام إصدار التقارير وحقن التواقيع الرقمية في سلسلة كتل C9" : "Reports issuance and digital signature injection into C9 Ledger"}
          </p>
        </div>
        <div className="text-right">
          <span className="text-xs text-slate-500 block">{isAr ? "الكيان المعزول" : "Isolated entity"}</span>
          <span className="text-sm font-semibold text-[#6FFFE9] font-mono">strictEntityId: {strictEntityId}</span>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div className="sovereign-glass p-5 rounded-xl border border-white/5">
          <div className="flex items-center justify-between mb-3">
            <span className="text-xs text-slate-400">{isAr ? "الوثائق المختومة" : "Sealed documents"}</span>
            <FolderCheck className="w-5 h-5 text-[#D4AF37]" />
          </div>
          <div className="text-2xl font-bold text-white font-mono">{documents.length}</div>
        </div>
        <div className="sovereign-glass p-5 rounded-xl border border-white/5">
          <div className="flex items-center justify-between mb-3">
            <span className="text-xs text-slate-400">{isAr ? "حالة النزاهة" : "Integrity"}</span>
            <Shield className="w-5 h-5 text-[#10B981]" />
          </div>
          <div className="text-2xl font-bold text-[#10B981] font-mono">100%</div>
        </div>
        <div className="sovereign-glass p-5 rounded-xl border border-white/5">
          <div className="flex items-center justify-between mb-3">
            <span className="text-xs text-slate-400">{isAr ? "خوارزمية التجزئة" : "Hash algorithm"}</span>
            <Key className="w-5 h-5 text-[#6FFFE9]" />
          </div>
          <div className="text-lg font-bold text-white font-mono">HMAC-SHA256</div>
        </div>
        <div className="sovereign-glass p-5 rounded-xl border border-white/5">
          <div className="flex items-center justify-between mb-3">
            <span className="text-xs text-slate-400">{isAr ? "الامتثال العام" : "Overall compliance"}</span>
            <Activity className="w-5 h-5 text-red-400" />
          </div>
          <div className="text-2xl font-bold text-white font-mono">99.8%</div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div className="lg:col-span-1 flex flex-col gap-8">
          <div className="sovereign-glass p-6 rounded-xl border border-white/5">
            <div className="flex items-center gap-2 mb-4 border-b border-white/5 pb-3">
              <Plus className="w-5 h-5 text-[#D4AF37]" />
              <h2 className="text-base font-bold text-white">{isAr ? "إصدار وثيقة جديدة" : "New document"}</h2>
            </div>
            <div className="space-y-4">
              <div>
                <label className="block text-xs text-slate-400 mb-2">{isAr ? "عنوان الوثيقة" : "Title"}</label>
                <input type="text" className="w-full bg-[#131926] border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none" value={newDocTitle} onChange={e => setNewDocTitle(e.target.value)} disabled={isGenerating} />
              </div>
              <div>
                <label className="block text-xs text-slate-400 mb-2">{isAr ? "نوع التقرير" : "Type"}</label>
                <select className="w-full bg-[#131926] border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none" value={newDocType} onChange={e => setNewDocType(e.target.value as DocumentType)} disabled={isGenerating}>
                  <option value="macro_compliance_report">{isAr ? "تقرير الامتثال الكلي" : "Macro compliance"}</option>
                  <option value="certified_payroll_wps">WPS</option>
                  <option value="forensic_c9_audit">C9 Audit</option>
                  <option value="freelance_nda_agreement">NDA</option>
                  <option value="municipal_health_permit">{isAr ? "رخصة بلدي" : "Municipal"}</option>
                </select>
              </div>
              <div>
                <label className="block text-xs text-slate-400 mb-2">{isAr ? "رقم الإصدار" : "Version"}</label>
                <input type="text" className="w-full bg-[#131926] border border-white/10 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none" value={customVersion} onChange={e => setCustomVersion(e.target.value)} disabled={isGenerating} />
              </div>
              <button className="w-full py-3 bg-gradient-to-r from-[#D4AF37] to-[#F3E5AB] text-black rounded-lg font-bold text-sm" onClick={runGenerationPipeline} disabled={isGenerating}>
                {isGenerating ? <RefreshCw className="w-4 h-4 animate-spin" /> : <Play className="w-4 h-4" />}
                {isGenerating ? (isAr ? "جارٍ التوليد..." : "Generating...") : (isAr ? "توليد وتصديق" : "Generate & Seal")}
              </button>
            </div>
          </div>

          <div className="sovereign-glass p-6 rounded-xl border border-white/5">
            <div className="flex items-center gap-2 mb-4 border-b border-white/5 pb-3">
              <Scale className="w-5 h-5 text-[#6FFFE9]" />
              <h2 className="text-base font-bold text-white">{isAr ? "المدقق الجنائي" : "Verifier"}</h2>
            </div>
            <div className="flex gap-2">
              <input type="text" className="flex-1 bg-[#131926] border border-white/10 rounded-lg px-3 py-2 text-xs text-white font-mono" placeholder="c9_block_hmac_..." value={verifyHashQuery} onChange={e => setVerifyHashQuery(e.target.value)} />
              <button className="bg-[#1E293B] hover:bg-slate-800 text-white px-4 py-2 rounded-lg text-xs font-bold" onClick={handleVerifyHash}>{isAr ? "تحقق" : "Verify"}</button>
            </div>
            {verificationResult.status !== "idle" && (
              <div className={`mt-3 p-4 rounded-lg border ${verificationResult.status === "valid" ? "bg-[#10B981]/5 border-[#10B981]/20 text-[#10B981]" : "bg-red-500/5 border-red-500/20 text-red-400"}`}>
                {verificationResult.status === "valid" ? (
                  <div>
                    <div className="flex items-center gap-2 text-xs font-bold"><CheckCheck className="w-4 h-4" />{isAr ? "وثيقة صالحة" : "Valid"}</div>
                    <div className="text-xs text-slate-400 mt-2">
                      <p>{verificationResult.docTitle}</p>
                      <p>Block #{verificationResult.blockIndex}</p>
                    </div>
                  </div>
                ) : (
                  <div className="flex items-center gap-2 text-xs font-bold"><AlertOctagon className="w-4 h-4" />{isAr ? "توقيع مجهول" : "Invalid"}</div>
                )}
              </div>
            )}
          </div>
        </div>

        <div className="lg:col-span-2 flex flex-col gap-8">
          {isGenerating && (
            <div className="sovereign-glass p-5 rounded-xl border border-[#D4AF37]/30 bg-[#0E121B]">
              <div className="flex items-center justify-between mb-3 border-b border-white/5 pb-2">
                <span className="text-xs font-bold text-[#D4AF37] font-mono">SADE COMPILATION TERMINAL</span>
              </div>
              <div className="h-44 bg-black border border-white/5 rounded-lg p-3 font-mono text-xs text-[#E2E8F0] overflow-y-auto space-y-1">
                {terminalLogs.map((log, idx) => <div key={idx} className="leading-relaxed">⚡ {log}</div>)}
                <div ref={terminalEndRef} />
              </div>
            </div>
          )}

          <div className="sovereign-glass p-6 rounded-xl border border-white/5">
            <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
              <h2 className="text-lg font-bold text-white">{isAr ? "خزانة الوثائق" : "Vault"}</h2>
              <div className="flex gap-2 flex-wrap">
                <select className="bg-[#131926] border border-white/10 rounded-lg px-3 py-1.5 text-xs text-white" value={activeTypeFilter} onChange={e => setActiveTypeFilter(e.target.value)}>
                  <option value="all">{isAr ? "كل الفئات" : "All"}</option>
                  <option value="certified_payroll_wps">WPS</option>
                  <option value="macro_compliance_report">{isAr ? "تقارير الامتثال" : "Compliance"}</option>
                  <option value="forensic_c9_audit">C9 Audit</option>
                  <option value="freelance_nda_agreement">NDA</option>
                  <option value="municipal_health_permit">{isAr ? "رخص بلدي" : "Municipal"}</option>
                </select>
                <div className="relative">
                  <input type="text" className="bg-[#131926] border border-white/10 rounded-lg pl-3 pr-8 py-1.5 text-xs text-white" placeholder={isAr ? "بحث..." : "Search..."} value={searchQuery} onChange={e => setSearchQuery(e.target.value)} />
                  <Search className="w-3.5 h-3.5 text-slate-500 absolute right-2.5 top-1/2 transform -translate-y-1/2" />
                </div>
              </div>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-right text-xs">
                <thead>
                  <tr className="border-b border-white/5 text-slate-400">
                    <th className="pb-3 pl-4">{isAr ? "المعرّف" : "ID"}</th>
                    <th className="pb-3 px-4">{isAr ? "العنوان" : "Title"}</th>
                    <th className="pb-3 px-4">{isAr ? "الفئة" : "Type"}</th>
                    <th className="pb-3 px-4">{isAr ? "التاريخ" : "Date"}</th>
                    <th className="pb-3 px-4">C9</th>
                    <th className="pb-3 pr-4 text-left">{isAr ? "إجراءات" : "Actions"}</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-white/5">
                  {documents.filter(d => activeTypeFilter === "all" || d.type === activeTypeFilter).filter(d => searchQuery === "" || d.title.toLowerCase().includes(searchQuery.toLowerCase()) || d.id.includes(searchQuery)).map(item => (
                    <tr key={item.id} className="hover:bg-white/[0.02]">
                      <td className="py-4 pl-4 font-mono font-bold text-[#6FFFE9]">{item.id}</td>
                      <td className="py-4 px-4 max-w-xs">
                        <div className="font-semibold text-white truncate">{item.title}</div>
                        <div className="text-[10px] text-slate-500 truncate font-mono">SHA256: {item.c9SignatureHash}</div>
                      </td>
                      <td className="py-4 px-4"><span className="px-2 py-1 rounded text-[10px] bg-[#D4AF37]/10 text-[#D4AF37]">{item.type}</span></td>
                      <td className="py-4 px-4 text-slate-400">{new Date(item.generatedAt).toLocaleDateString("ar-SA")}</td>
                      <td className="py-4 px-4 text-slate-400 font-mono">Block #{item.c9BlockIndex}</td>
                      <td className="py-4 pr-4 text-left">
                        <div className="flex justify-end gap-2">
                          <button className="p-1.5 bg-[#1E293B] hover:bg-slate-700 text-white rounded" onClick={() => triggerToast(isAr ? "معاينة" : "Preview")}><Eye className="w-3.5 h-3.5" /></button>
                          <button className="p-1.5 bg-[#1E293B] hover:bg-slate-700 text-[#D4AF37] rounded" onClick={() => triggerToast(isAr ? "تحميل" : "Download")}><Download className="w-3.5 h-3.5" /></button>
                          <button className="p-1.5 bg-[#1E293B] hover:bg-slate-700 text-[#6FFFE9] rounded" onClick={() => triggerToast(isAr ? "طباعة" : "Print")}><Printer className="w-3.5 h-3.5" /></button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default SovereignAutoDocumentationEngine;
