export interface HealthComplianceResult {
  status: "complete" | "partial" | "non_compliant";
  textAr: string;
  textEn: string;
  colorClass: string;
  icon: string;
}

export function getHealthComplianceBadge(b: Branch, staff: any[]): HealthComplianceResult {
  const isHealthSector = ["restaurant", "cafe", "health", "salon"].includes(b.branch_type);
  if (!isHealthSector) {
    return {
      status: "complete",
      textAr: "مكتمل",
      textEn: "Complete",
      colorClass: "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
      icon: "🟢"
    };
  }
  if (!staff || staff.length === 0) {
    return {
      status: "non_compliant",
      textAr: "غير متوافق (شاغر)",
      textEn: "Non-Compliant (Empty)",
      colorClass: "bg-red-500/10 text-rose-400 border border-red-500/20",
      icon: "🔴"
    };
  }
  const total = staff.length;
  const expiredCount = staff.filter((w: any) => {
    if (!w.healthCertificate) return true;
    const isExpired = new Date(w.healthCertificate.expiryDate) < new Date("2026-05-20");
    return isExpired;
  }).length;

  if (expiredCount === 0) {
    return {
      status: "complete",
      textAr: "مكتمل",
      textEn: "Complete",
      colorClass: "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
      icon: "🟢"
    };
  } else if (expiredCount < total) {
    return {
      status: "partial",
      textAr: "ناقص",
      textEn: "Partial",
      colorClass: "bg-amber-500/10 text-amber-500 border border-amber-500/20",
      icon: "🟡"
    };
  } else {
    return {
      status: "non_compliant",
      textAr: "غير متوافق",
      textEn: "Non-Compliant",
      colorClass: "bg-red-500/10 text-rose-400 border border-red-500/20 animate-pulse",
      icon: "🔴"
    };
  }
}

export function getBranchReadiness(b: Branch, staff: any[], attendanceLogs: any[] = []): number {
  let score = 0;
  
  // 1. License: 40%
  const lic = getLicenseStatus(b);
  if (lic.status === "valid") score += 40;

  // 2. Geofence + GPS Active Status: 30%
  if (b.branch_status === "active") {
    if (b.latitude >= 15.0 && b.latitude <= 32.5 && b.longitude >= 34.0 && b.longitude <= 55.0 && b.safety_radius >= 10) {
      score += 30;
    }
  }

  const isHealthSector = ["restaurant", "cafe", "health", "salon"].includes(b.branch_type);
  const total = staff.length;

  // 3. Health Certificates: 20%
  if (!isHealthSector) {
    score += 20;
  } else {
    if (total > 0) {
      const compliantStaff = staff.filter((w: any) => {
        if (!w.healthCertificate) return false;
        const isExpired = new Date(w.healthCertificate.expiryDate) < new Date("2026-05-20");
        return !isExpired;
      }).length;
      score += Math.round((compliantStaff / total) * 20);
    }
  }

  // 4. Attendance: 10%
  if (total === 0) {
    score += isHealthSector ? 0 : 10;
  } else {
    const onSiteGPSCount = staff.filter((w: any) => {
      const logs = (attendanceLogs || []).filter((l: any) => l.employeeName === w.name);
      return logs.length > 0 && !logs[0].alert;
    }).length;
    score += Math.round((onSiteGPSCount / total) * 10);
  }

  return Math.min(100, score);
}

export function ReadinessGauge({ score, isDark }: { score: number; isDark: boolean }) {
  const radius = 18;
  const stroke = 3;
  const normalizedRadius = radius - stroke;
  const circumference = normalizedRadius * 2 * Math.PI;
  const strokeDashoffset = smoothnessScale(score, circumference);

  function smoothnessScale(s: number, circ: number) {
    const pct = s / 100;
    return circ - pct * circ;
  }

  const strokeColor = score >= 90 
    ? "stroke-emerald-400" 
    : score >= 70 
      ? "stroke-amber-400" 
      : "stroke-rose-500";

  const textColor = score >= 90 
    ? "text-emerald-400" 
    : score >= 70 
      ? "text-amber-400" 
      : "text-rose-400";

  return (
    <div className="relative flex items-center justify-center shrink-0 w-11 h-11">
      <svg className="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
        <circle
          cx="18"
          cy="18"
          r={normalizedRadius}
          fill="transparent"
          stroke={isDark ? "rgba(255, 255, 255, 0.06)" : "rgba(0, 0, 0, 0.06)"}
          strokeWidth={stroke}
        />
        <circle
          cx="18"
          cy="18"
          r={normalizedRadius}
          fill="transparent"
          stroke="currentColor"
          strokeWidth={stroke}
          strokeDasharray={circumference + " " + circumference}
          style={{ strokeDashoffset }}
          className={`transition-all duration-700 ease-out fill-none ${strokeColor}`}
        />
      </svg>
      <div className="absolute inset-x-0 inset-y-0 flex flex-col items-center justify-center">
        <span className={`text-[8.5px] font-mono font-black ${textColor}`}>{score}%</span>
      </div>
    </div>
  );
}

interface EntityManagerBranchesViewProps {
  branches: Branch[];
  setBranches: React.Dispatch<React.SetStateAction<Branch[]>>;
  selectedBranchId: string;
  setSelectedBranchId: (id: string) => void;
  getBranchCompliance: (b: Branch) => number;
  pushNewC9Event: (type: string, refId: string, payload: any) => void;
  addAlert: (text: string, severity: "low" | "medium" | "high") => void;
  lang: "ar" | "en";
  isDark: boolean;
  workforce: any;
  attendanceLogs?: any[];
}

export function EntityManagerBranchesView({
  branches,
  setBranches,
  selectedBranchId,
  setSelectedBranchId,
  getBranchCompliance,
  pushNewC9Event,
  addAlert,
  lang,
  isDark,
  workforce,
  attendanceLogs = []
}: EntityManagerBranchesViewProps) {
  const [searchTerm, setSearchTerm] = useState("");
  const [filterType, setFilterType] = useState<string>("all");
  const [showAddModal, setShowAddModal] = useState(false);

  // Dynamic Map Coordinates Picker / Validator State
  const [isEditingLocation, setIsEditingLocation] = useState(false);
  const [editLat, setEditLat] = useState("");
  const [editLng, setEditLng] = useState("");
  const [editRadius, setEditRadius] = useState("");

  const startEditingLocation = (b: Branch) => {
    setEditLat(b.latitude.toFixed(5));
    setEditLng(b.longitude.toFixed(5));
    setEditRadius(b.safety_radius.toString());
    setIsEditingLocation(true);
    addAlert(
      lang === "ar" 
        ? "وضع تعديل الإحداثيات نشط: انقر مباشرةً على الرادار لتحديد الموقع الجديد للفرع!" 
        : "Interactive GPS mapping mode active: Click anywhere on the radar map to pinpoint coordinates!", 
      "low"
    );
  };

  const cancelEditingLocation = () => {
    setIsEditingLocation(false);
  };

  const saveLocationChanges = (b: Branch) => {
    const freshLat = parseFloat(editLat);
    const freshLng = parseFloat(editLng);
    const freshRad = parseFloat(editRadius) || 100;

    // Run LEXI validation checking
    const check = LEXI.validateBranch({
      branch_name: b.branch_name,
      branch_type: b.branch_type,
      municipality_license_number: b.municipality_license_number,
      latitude: freshLat,
      longitude: freshLng,
      safety_radius: freshRad
    });

    if (check.decision === "block") {
      addAlert(
        lang === "ar"
          ? `عذرًا، تم حظر الموقع بقرار سيادي من LEXI: ${check.reason}`
          : `Block stamp issued by LEXI: ${check.reason}`,
        "high"
      );
      return;
    }

    const updated = branches.map(item => item.id === b.id ? {
      ...item,
      latitude: freshLat,
      longitude: freshLng,
      safety_radius: freshRad
    } : item);

    setBranches(updated);
    pushNewC9Event("تعديل ومعايرة إحداثيات الموقع على الخريطة", b.id, { latitude: freshLat, longitude: freshLng, safety_radius: freshRad });
    addAlert(
      lang === "ar"
        ? `تم تعديل وتثبيت موقع فرع "${b.branch_name}" ومطابقتها تنظيمياً!`
        : `Updated and locked geofence parameters for branch "${b.branch_name}"!`,
      "medium"
    );
    setIsEditingLocation(false);
  };

  // Search and filter branches
  const filteredBranches = branches.filter(b => {
    const matchesSearch = b.branch_name.toLowerCase().includes(searchTerm.toLowerCase()) || 
                          b.municipality_license_number.includes(searchTerm);
    const matchesType = filterType === "all" || b.branch_type === filterType;
    return matchesSearch && matchesType;
  });

  const selectedBranch = branches.find(b => b.id === selectedBranchId) || branches[0];

  // Plotting pixel offsets on SVG based on geographic coordinates
  const getCoordsPixel = (lat: number, lng: number) => {
    const centerX = 46.6753; // Riyadh Center Lng
    const centerY = 24.7136; // Riyadh Center Lat
    const scaleX = 420;      // pixel scaling
    const scaleY = -420;     // negative because Lat goes higher up but screens go down
    return {
      x: 200 + (lng - centerX) * scaleX,
      y: 150 + (lat - centerY) * scaleY
    };
  };

  const liveLat = (selectedBranch && isEditingLocation) ? (parseFloat(editLat) || selectedBranch.latitude) : (selectedBranch ? selectedBranch.latitude : 24.7136);
  const liveLng = (selectedBranch && isEditingLocation) ? (parseFloat(editLng) || selectedBranch.longitude) : (selectedBranch ? selectedBranch.longitude : 46.6753);

  const activePixel = getCoordsPixel(liveLat, liveLng);

  return (
    <div className="space-y-6">
      {/* 1. Header Filters & Tools */}
      <div className={`p-4 rounded-xl border flex flex-col md:flex-row gap-4 justify-between items-center ${isDark ? "bg-black/40 border-white/5" : "bg-white border-neutral-200"}`}>
        <div className="flex flex-wrap items-center gap-2.5 w-full md:w-auto">
          {/* Add Branch Button */}
          <button
            id="add-branch-btn"
            onClick={() => setShowAddModal(true)}
            className="cursor-pointer bg-[#D4AF37] hover:bg-[#b08f2e] text-black font-extrabold px-4 py-2 rounded-lg text-xs flex items-center gap-1.5 transition duration-150 shadow-md shadow-[#D4AF37]/10"
          >
            <Plus className="w-4 h-4 stroke-[3]" />
            <span>{lang === "ar" ? "تسجيل فرع جديد" : "Register New Branch"}</span>
          </button>

          {/* Activity Filter */}
          <select
            value={filterType}
            onChange={e => setFilterType(e.target.value)}
            className={`cursor-pointer text-xs p-2 rounded-lg border ${isDark ? "bg-black text-gray-200 border-white/10" : "bg-neutral-100 text-neutral-800 border-neutral-300"}`}
          >
            <option value="all">{lang === "ar" ? "كل الأنشطة الرقابية" : "All Regulatory Segments"}</option>
            {Object.entries(municipalTypeLabels).map(([key, val]) => (
              <option key={key} value={key}>{lang === "ar" ? val.ar : val.en}</option>
            ))}
          </select>
        </div>

        {/* Search */}
        <div className="relative w-full md:w-80">
          <input
            type="text"
            value={searchTerm}
            onChange={e => setSearchTerm(e.target.value)}
            placeholder={lang === "ar" ? "ابحث بالاسم أو رقم الرخصة..." : "Search by name or license..."}
            className={`w-full p-2.5 pl-9 text-xs rounded-lg border text-right focus:outline-none focus:border-[#D4AF37] ${isDark ? "bg-black/60 text-white border-white/10" : "bg-neutral-50 text-neutral-900 border-neutral-300"}`}
          />
          <Search className="w-4 h-4 text-gray-400 absolute left-3 top-3 pointer-events-none" />
        </div>
      </div>

      {/* 2. Map & Detailed Selected Branch Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* Holographic Signal Radar Map (7 Columns) */}
        <div className="lg:col-span-7 space-y-3">
          <div className="flex justify-between items-center border-b border-white/5 pb-2">
            <span className="text-[10px] text-gray-400 font-mono">RIYADH DISTRICT COORDS MAPPING HUD</span>
            <h4 className="text-xs font-extrabold text-[#D4AF37] flex items-center gap-1">
              <Compass className="text-[#D4AF37] w-3.5 h-3.5 animate-spin" style={{ animationDuration: "12s" }} />
              <span>{lang === "ar" ? "رادار الامتثال والحدود الجغرافية للفروع" : "Active Municipal Geofencing Radar Map"}</span>
            </h4>
          </div>

          <div className={`relative border rounded-2xl p-4 overflow-hidden ${isDark ? "bg-[#040811]/95 border-blue-500/20" : "bg-neutral-900 text-white border-neutral-700"}`} style={{ height: "360px" }}>
            {/* Ambient effects */}
            <div className="absolute inset-0 bg-[linear-gradient(rgba(20,80,250,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(20,80,250,0.03)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none" />
            
            {/* Top Right Label */}
            <div className="absolute top-3 right-4 flex items-center gap-1.5 flex-row-reverse text-[9px] font-mono text-gray-400">
              <span className="w-2 h-2 rounded-full bg-blue-500 animate-ping" />
              <span>{lang === "ar" ? "نظام الضبط الجغرافي النشط للبلديات" : "MUNICIPAL GEOLOCATION ACTIVE"}</span>
            </div>

            {/* Float Overlay Info Box */}
            {selectedBranch && (
              <div className="absolute bottom-3 left-3 bg-black/85 border border-white/10 rounded-xl p-3 text-right font-mono text-[9px] text-gray-400 space-y-1 z-10 max-w-xs shadow-lg">
                <div className="text-white font-extrabold flex items-center justify-end gap-1 flex-row-reverse text-[10px] pb-1 border-b border-white/10 mb-1">
                  <span className="text-[#D4AF37] font-sans truncate">{selectedBranch.branch_name}</span>
                  <span>📍</span>
                </div>
                <div>ID: <span className="text-white">{selectedBranch.id}</span></div>
                <div>LAT: <span className="text-white">{selectedBranch.latitude.toFixed(5)}</span></div>
                <div>LNG: <span className="text-white">{selectedBranch.longitude.toFixed(5)}</span></div>
                <div>SAFETY BOUNDS: <span className="text-white">{selectedBranch.safety_radius}m</span></div>
                <div>STATUS: <span className={selectedBranch.branch_status === "active" ? "text-emerald-400" : "text-rose-500"}>{selectedBranch.branch_status.toUpperCase()}</span></div>
                <div className="pt-1 mt-1 border-t border-white/10 text-[8px] text-blue-300 flex justify-between">
                  <span>{workforce[selectedBranch.id]?.length || 0}</span>
                  <span>{lang === "ar" ? "موظفي الفرع النشطين:" : "Active assigned staff:"}</span>
                </div>
              </div>
            )}

            {/* Radar Viewport */}
            <svg className="w-full h-full" viewBox="0 0 400 300">
              <line x1="200" y1="0" x2="200" y2="300" stroke="rgba(255,255,255,0.04)" />
              <line x1="0" y1="150" x2="400" y2="150" stroke="rgba(255,255,255,0.04)" />
              <circle cx="200" cy="150" r="110" fill="none" stroke="rgba(20,80,250,0.03)" strokeDasharray="3,3" />
              <circle cx="200" cy="150" r="60" fill="none" stroke="rgba(20,80,250,0.03)" strokeDasharray="3,3" />

              {/* Render Geofence Radius Circles */}
              {branches.map(b => {
                const pos = getCoordsPixel(b.latitude, b.longitude);
                const isSel = b.id === selectedBranchId;
                const score = getBranchCompliance(b);
                const color = b.branch_status === "suspended" 
                  ? "rgba(239, 68, 68, 0.4)" 
                  : score < 100 
