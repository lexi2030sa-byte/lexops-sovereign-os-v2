                    />
                    {/* Dot coordinate anchor */}
                    <circle
                      cx={pos.x}
                      cy={pos.y}
                      r={isSel ? "4.5" : "3"}
                      fill={isSel ? "#D4AF37" : b.branch_status === "suspended" ? "#ef4444" : "#10b981"}
