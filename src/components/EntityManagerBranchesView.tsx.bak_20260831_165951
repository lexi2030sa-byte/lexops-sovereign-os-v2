              {formData.municipality_license_number && (
                <div className="mt-1.5 text-[9px] font-sans font-black flex items-center justify-end gap-1 flex-row-reverse">
                  {!formData.municipality_license_number.startsWith("14") ? (
                    <span className="text-rose-400">❌ {lang === "ar" ? "بادئة رخصة بلدية غير صالحة (يجب أن تبدأ بـ 14)" : "Invalid prefix (must start with 14)"}</span>
                  ) : formData.municipality_license_number.replace(/\D/g, "").length < 10 ? (
                    <span className="text-amber-400">⚠️ {lang === "ar" ? "رقم رخصة بلدي ناقص (تشترط 10 أرقام على الأقل)" : "Incomplete (Balady rules require at least 10 numbers)"}</span>
                  ) : (
                    <span className="text-emerald-400 font-extrabold">✅ {lang === "ar" ? "رخصة بلدية صالحة ومطابقة للأنظمة" : "Valid Balady License Verified ✅"}</span>
                  )}
                </div>
              )}
            </div>

            <div>
              <label className="block text-[10px] text-gray-400 mb-1 font-bold">{lang === "ar" ? "نصف قطر الأمان الوقائي (متر):" : "Safe Geofence Radius (m):"}</label>
              <input
                type="number"
                required
                value={formData.safety_radius}
                onChange={e => setFormData({ ...formData, safety_radius: e.target.value })}
                placeholder="100"
                className={`w-full p-2 text-xs rounded focus:border-[#D4AF37] focus:outline-none text-right font-mono ${isDark ? "bg-black/60 text-white border-white/10" : "bg-neutral-50 text-neutral-900 border-neutral-300"}`}
              />
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label className="block text-[10px] text-gray-400 mb-1 font-bold">{lang === "ar" ? "خط العرض الجغرافي (داخل السعودية):" : "GPS Latitude Anchor (KSA bounds):"}</label>
              <input
                type="text"
                required
                value={formData.latitude}
                onChange={e => setFormData({ ...formData, latitude: e.target.value })}
                placeholder="24.7136"
                className={`w-full p-2 text-xs rounded focus:border-[#D4AF37] focus:outline-none text-right font-mono ${isDark ? "bg-black/60 text-white border-white/10" : "bg-neutral-50 text-neutral-900 border-neutral-300"}`}
              />
            </div>

            <div>
              <label className="block text-[10px] text-gray-400 mb-1 font-bold">{lang === "ar" ? "خط الطول الجغرافي (داخل السعودية):" : "GPS Longitude Anchor (KSA bounds):"}</label>
              <input
                type="text"
                required
                value={formData.longitude}
                onChange={e => setFormData({ ...formData, longitude: e.target.value })}
                placeholder="46.6753"
                className={`w-full p-2 text-xs rounded focus:border-[#D4AF37] focus:outline-none text-right font-mono ${isDark ? "bg-black/60 text-white border-white/10" : "bg-neutral-50 text-neutral-900 border-neutral-300"}`}
              />
            </div>
          </div>

          {/* Interactive Live Safety Radius SVG Circle Visualizer before Saving */}
          <div className={`p-4 rounded-xl border flex flex-col items-center justify-center relative ${isDark ? "bg-black/50 border-white/5" : "bg-neutral-50 border-neutral-200"}`}>
            <div className="text-right w-full mb-1">
              <span className="text-[#D4AF37] text-[10px] bg-[#D4AF37]/10 px-2 py-0.5 rounded font-sans font-extrabold animate-pulse">
                💡 {lang === "ar" ? "اضغط على أي مكان بالخريطة لتحديد الإحداثيات فورياً!" : "Click anywhere on the map to set the coordinates directly!"}
              </span>
            </div>
            <div className="flex justify-between items-center w-full mb-2 flex-row-reverse text-[9px] font-mono border-t border-white/5 pt-1.5">
              <span className="text-[#D4AF37] font-sans font-black flex items-center gap-1">
                <span>📍 {lang === "ar" ? "خرائط المحاكاة الجغرافية والتحقق السيادي:" : "Sovereign Geofence Simulator Map Preview:"}</span>
              </span>
              
              {/* Check if coordinates reside outside Saudi Arabia kingdom bounds */}
              {(() => {
                const lat = parseFloat(formData.latitude) || 0;
                const lng = parseFloat(formData.longitude) || 0;
                const isOutside = (lat < 15.0 || lat > 32.5 || lng < 34.0 || lng > 55.0);
                return isOutside ? (
                  <span className="text-red-400 font-extrabold animate-pulse">
                    ⚠️ {lang === "ar" ? "إحداثيات خارج الحدود السيادية!" : "GPS OUTSIDE KSA BOUNDS!"}
                  </span>
                ) : (
                  <span className="text-emerald-400">
                    🟢 {lang === "ar" ? "إحداثيات داخل الحدود التنظيمية" : "Inside Sovereign Territory"}
                  </span>
                );
              })()}
            </div>

            <div className={`relative w-full h-28 flex items-center justify-center bg-black/90 rounded-lg overflow-hidden border ${
              (() => {
                const lat = parseFloat(formData.latitude) || 0;
                const lng = parseFloat(formData.longitude) || 0;
                return (lat < 15.0 || lat > 32.5 || lng < 34.0 || lng > 55.0) ? "border-red-500/55 bg-red-950/20" : "border-white/5";
              })()
            }`}>
              <div className="absolute inset-0 bg-[linear-gradient(rgba(20,80,250,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(20,80,250,0.02)_1px,transparent_1px)] bg-[size:16px_16px] pointer-events-none" />
              
              <svg 
                className="w-full h-full cursor-crosshair" 
                viewBox="0 0 400 100"
                onClick={(e) => {
                  const rect = e.currentTarget.getBoundingClientRect();
                  const clickPctX = (e.clientX - rect.left) / rect.width;
                  const clickPctY = (e.clientY - rect.top) / rect.height;

                  const minLat = 15.0;
                  const maxLat = 32.5;
                  const minLng = 34.0;
                  const maxLng = 55.0;

                  const lng = minLng + clickPctX * (maxLng - minLng);
                  const lat = minLat + (1.0 - clickPctY) * (maxLat - minLat);

                  setFormData(prev => ({
                    ...prev,
                    latitude: lat.toFixed(5),
                    longitude: lng.toFixed(5)
                  }));
                }}
              >
                <line x1="200" y1="0" x2="200" y2="100" stroke="rgba(255,255,255,0.03)" />
                <line x1="0" y1="50" x2="400" y2="50" stroke="rgba(255,255,255,0.03)" />
                
                {/* Stylized vector boundary of Saudi Arabia (KSA) */}
                <path
                  d="M 100 25 L 140 15 L 180 16 L 220 20 L 260 25 L 300 22 L 320 32 L 280 42 L 260 62 L 240 72 L 220 82 L 160 85 L 130 72 L 100 62 L 80 52 L 75 40 Z"
                  fill="none"
                  stroke={(() => {
                    const lat = parseFloat(formData.latitude) || 0;
                    const lng = parseFloat(formData.longitude) || 0;
                    return (lat < 15.0 || lat > 32.5 || lng < 34.0 || lng > 55.0) ? "rgba(239, 68, 68, 0.2)" : "rgba(212, 175, 55, 0.15)";
                  })()}
                  strokeWidth="1.5"
                  strokeDasharray="4,4"
                />

                {/* Plotting coordinate node mapping calculated dynamically */}
                {(() => {
                  const lat = parseFloat(formData.latitude) || 24.7136;
                  const lng = parseFloat(formData.longitude) || 46.6753;
                  const minLat = 15.0;
                  const maxLat = 32.5;
                  const minLng = 34.0;
                  const maxLng = 55.0;

                  const pctX = (lng - minLng) / (maxLng - minLng);
                  const pctY = 1.0 - (lat - minLat) / (maxLat - minLat); // Lat grows upwards, Y decreases down

                  const x = Math.max(10, Math.min(390, pctX * 400));
                  const y = Math.max(10, Math.min(90, pctY * 100));

                  const isOut = (lat < 15.0 || lat > 32.5 || lng < 34.0 || lng > 55.0);
                  const colorMatch = isOut ? "#ef4444" : "#D4AF37";

                  return (
                    <g>
                      {/* Safe Geofence circular radius */}
                      <circle
                        cx={x}
                        cy={y}
                        r={previewRadius}
                        fill={isOut ? "rgba(239, 68, 68, 0.05)" : "rgba(212, 175, 55, 0.04)"}
                        stroke={colorMatch}
                        strokeWidth="1"
                        className="transition-all duration-300"
                        strokeDasharray={isOut ? "2,2" : "0"}
                      />
                      
                      {/* GPS Blip Ring */}
                      <circle
                        cx={x}
                        cy={y}
                        r="6"
                        fill="none"
                        stroke={colorMatch}
                        strokeWidth="1"
                        className="animate-ping"
                      />

                      {/* GPS Dot */}
                      <circle cx={x} cy={y} r="2.5" fill={colorMatch} />
                      
                      {/* Marker Metadata Flag */}
                      <text x={x + 7} y={y + 2} fill={isOut ? "#f87171" : "#e5e7eb"} fontSize="6" fontFamily="monospace">
                        LAT: {lat.toFixed(4)} | LNG: {lng.toFixed(4)}
                      </text>
                      <text x={x + 7} y={y + 8} fill={isOut ? "#ef4444" : "#D4AF37"} fontSize="5.5" fontFamily="monospace" fontWeight="bold">
                        FENCE RAD: {formData.safety_radius || "100"}m
                      </text>
                    </g>
                  );
                })()}
              </svg>
            </div>
          </div>

          {/* Interactive LEXI Evaluative Guard v7.0 */}
          {lexiResult && (
            <div className={`p-4 rounded-xl text-right text-xs space-y-1.5 transition-all ${lexiResult.decision === "block" ? "bg-red-500/10 border border-red-500/30 text-red-200" : "bg-emerald-500/10 border border-emerald-500/35 text-emerald-200"}`}>
              <div className="flex justify-between items-center border-b border-white/5 pb-1 flex-row-reverse mb-1">
                <span className="font-sans font-black text-[#D4AF37] flex items-center gap-1.5">
                  <FileCheck className="w-4 h-4" />
                  <span>{lang === "ar" ? "تحليل الامتثال الرقمي بمحرك LEXI" : "LEXI DECISION RESPONSE"}</span>
                </span>
                <span className="font-mono text-[9px] font-bold bg-[#D4AF37]/20 text-[#D4AF37] px-1.5 rounded">{lexiResult.sealId}</span>
              </div>
              <p className="font-sans text-[10px] text-gray-400">
                <strong className="text-white">{lang === "ar" ? "المادة النظامية:" : "Statutory Article:"}</strong> {lexiResult.article}
              </p>
              <p className="font-medium text-xs font-sans leading-relaxed pt-1">
                <strong className="text-white">{lang === "ar" ? "قرار الفحص والتعليق:" : "Evaluation Outcome:"}</strong> {lexiResult.reason}
              </p>
              {lexiResult.decision === "block" && (
                <div className="flex items-center gap-1.5 justify-end text-rose-400 font-bold font-sans text-[10px] pt-1 pt-1.5 border-t border-red-500/10 mt-1.5">
                  <span>{lang === "ar" ? "القرار السيادي: تم الرفض وحظر التفعيل الفوري." : "SOVEREIGN DECISION: PROPOSAL STRICTLY REFUSED & BLOCKED."}</span>
                  <AlertTriangle className="w-3.5 h-3.5 text-rose-400 stroke-[2.5]" />
                </div>
              )}
            </div>
          )}

          <div className="flex justify-between items-center pt-3 border-t border-white/10 flex-row-reverse">
            <button
              type="submit"
              disabled={lexiResult?.decision === "block"}
              className={`bg-[#D4AF37] hover:bg-[#b08f2e] text-black font-extrabold px-6 py-2 rounded-lg text-xs transition active:scale-95 cursor-pointer flex items-center gap-1.5 ${lexiResult?.decision === "block" ? "opacity-30 cursor-not-allowed" : ""}`}
            >
              <ShieldCheck className="w-4.5 h-4.5 text-black" />
              <span>{lang === "ar" ? "تصديق وتدشين الفرع بالكتلة" : "Confirm Sovereign Registration"}</span>
            </button>
            <span className="text-[9px] font-mono text-gray-500">LEDGER C9-V7-SECURITY</span>
          </div>

        </form>
      </motion.div>
    </div>
  );
}

