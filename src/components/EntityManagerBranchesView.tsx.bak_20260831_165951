interface AddBranchModalProps {
  onClose: () => void;
  onAddBranch: (b: {
    branch_name: string;
    branch_type: string;
    municipality_license_number: string;
    latitude: number;
    longitude: number;
    safety_radius: number;
  }) => void;
  lang: "ar" | "en";
  isDark: boolean;
}

export function AddBranchModal({ onClose, onAddBranch, lang, isDark }: AddBranchModalProps) {
  const [formData, setFormData] = useState({
    branch_name: "",
    branch_type: "restaurant",
    municipality_license_number: "",
    latitude: "24.7136",
    longitude: "46.6753",
    safety_radius: "100"
  });

  const [lexiResult, setLexiResult] = useState<LexiResult | null>(null);
  const [stampStatus, setStampStatus] = useState<"idle" | "success" | "shaking">("idle");

  // Real-time automatic LEXI verification as inputs update
  React.useEffect(() => {
    const lat = parseFloat(formData.latitude) || 0;
    const lng = parseFloat(formData.longitude) || 0;
    const radius = parseFloat(formData.safety_radius) || 0;

    const check = LEXI.validateBranch({
      branch_name: formData.branch_name,
      branch_type: formData.branch_type,
      municipality_license_number: formData.municipality_license_number,
      latitude: lat,
      longitude: lng,
      safety_radius: radius
    });

    setLexiResult(check);
  }, [formData]);

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();

    // Compile values
    const lat = parseFloat(formData.latitude) || 0;
    const lng = parseFloat(formData.longitude) || 0;
    const radius = parseFloat(formData.safety_radius) || 100;

    // Run final verification check
    const check: LexiResult = LEXI.validateBranch({
      branch_name: formData.branch_name,
      branch_type: formData.branch_type,
      municipality_license_number: formData.municipality_license_number,
      latitude: lat,
      longitude: lng,
      safety_radius: radius
    });

    setLexiResult(check);

    if (check.decision === "block") {
      setStampStatus("shaking");
      setTimeout(() => setStampStatus("idle"), 800);
      return;
    }

    setStampStatus("success");

    // Success Block - delay slightly to show LEXI ALLOW stamp with Gold flash
    setTimeout(() => {
      onAddBranch({
        branch_name: formData.branch_name,
        branch_type: formData.branch_type,
        municipality_license_number: formData.municipality_license_number,
        latitude: lat,
        longitude: lng,
        safety_radius: radius
      });
      onClose();
    }, 1200);
  };

  // Convert radius to a neat preview size
  const previewRadius = Math.min(48, Math.max(12, parseFloat(formData.safety_radius) / 3));

  return (
    <div className="fixed inset-0 bg-black/80 backdrop-blur-sm flex justify-center items-center z-50 p-4">
      <motion.div
        initial={{ scale: 0.95, opacity: 0 }}
        animate={stampStatus === "shaking" ? { 
          x: [0, -6, 6, -6, 6, 0],
          borderColor: ["rgba(239, 68, 68, 0.4)", "rgba(239, 68, 68, 0.8)", "rgba(239, 68, 68, 0.4)"] 
