// Global License Evaluation Helper
export function getLicenseStatus(b: Branch): { status: "valid" | "expired" | "missing"; textAr: string; textEn: string; colorClass: string } {
  if (!b.municipality_license_number || b.municipality_license_number.trim() === "") {
    return {
      status: "missing",
      textAr: "رخصة مفقودة ⚠️",
      textEn: "Missing License ⚠️",
      colorClass: "bg-red-500/10 text-rose-400 border border-red-500/30"
    };
  }
  // Let BR-104 represent expired status for demo diversity
  if (b.id === "BR-104") {
    return {
      status: "expired",
      textAr: "منتهية الصلاحية ❌",
      textEn: "License Expired ❌",
      colorClass: "bg-amber-500/10 text-amber-500 border border-amber-500/30 animate-pulse"
    };
  }
  return {
    status: "valid",
    textAr: "رخصة سارية ✅",
    textEn: "Valid License ✅",
    colorClass: "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30"
  };
}

