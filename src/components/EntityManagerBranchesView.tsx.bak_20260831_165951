                      <input
                        type="text"
                        value={editLng}
                        onChange={e => setEditLng(e.target.value)}
                        className={`w-full p-2 text-xs rounded border focus:border-[#D4AF37] focus:outline-none text-right font-mono ${isDark ? "bg-black text-white border-white/10" : "bg-neutral-50 text-neutral-900 border-neutral-300"}`}
                      />
