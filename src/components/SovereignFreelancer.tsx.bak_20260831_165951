                          className="w-full bg-black border border-white/10 rounded-xl p-2 text-xs text-white resize-none"
                        />
                      </div>

                      <div>
                        <label className="block text-[10px] text-gray-400 mb-1 font-bold">{lang === "ar" ? "اسم الملف المحاكي للرفع:" : "Mock File Reference"}</label>
                        <input
                          type="text"
                          value={newEvidenceFile}
                          onChange={e => setNewEvidenceFile(e.target.value)}
                          placeholder="camera_match_screenshot.png"
                          className="w-full bg-black border border-white/10 rounded-xl p-2 text-xs text-white"
                        />
                      </div>

                      <button
                        type="submit"
                        className="w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-xl cursor-pointer"
                      >
                        {lang === "ar" ? "توثيق وبث القرينة بالسجل" : "Confirm Legal Import"}
                      </button>
                    </form>
                  )}

                  {/* 3. Document details sheet view */}
                  {activeBottomSheet === "doc_details" && selectedDoc && (
                    <div className="space-y-3 text-right text-xs pt-1">
                      <div className="bg-black/60 p-3.5 rounded-xl border border-white/10 space-y-2">
                        <span className="text-[10px] text-[#D4AF37] font-bold block">موضوع الوثيقة: {selectedDoc.title}</span>
                        <p className="text-gray-300 leading-normal">{selectedDoc.note}</p>
                      </div>

                      <div className="grid grid-cols-2 gap-2 font-mono text-[9px] bg-black/40 p-3 rounded-lg border border-white/5">
                        <div>
                          <span className="text-gray-500 block">رقم الكود التسلسلي</span>
                          <span className="text-white font-bold block">{selectedDoc.id}</span>
                        </div>
                        <div>
                          <span className="text-gray-500 block">الحجم الكروي</span>
                          <span className="text-white font-bold block">{selectedDoc.size}</span>
                        </div>
                        <div className="col-span-2">
                          <span className="text-gray-500 block">البصمة الرياضية المشفرة (SHA256)</span>
                          <span className="text-[#D4AF37] uppercase break-all block text-[8px] mt-0.5">{selectedDoc.hash}</span>
                        </div>
                      </div>

                      <button
                        type="button"
                        onClick={() => {
                          triggerHapticFeedback("download");
                          alert("🟢 بدء تنزيل المستند والشهادة الرقمية المشفقة بصيفة PDF على جهازك المحمول!");
                        }}
                        className="w-full py-2 bg-[#D4AF37] hover:bg-amber-600 text-black font-extrabold text-xs rounded-xl flex items-center justify-center gap-1 cursor-pointer transition"
                      >
                        <Download className="w-4 h-4" />
                        <span>تحميل المستند مع شهادة الالتزام C9</span>
                      </button>
                    </div>
                  )}

                  {/* 4. Evidence details sheet view */}
                  {activeBottomSheet === "evidence_details" && selectedEvidence && (
                    <div className="space-y-3 text-right text-xs pt-1">
                      <div className="bg-black/80 border border-emerald-500/25 p-3.5 rounded-xl space-y-2">
                        <span className="text-[10px] text-emerald-400 font-bold block">نص القرينة: {selectedEvidence.type}</span>
                        <p className="leading-relaxed text-gray-200">{selectedEvidence.text}</p>
                      </div>

                      <div className="p-3 bg-black/40 rounded-lg text-[9px] space-y-1.5 leading-snug">
                        <div className="flex justify-between font-mono">
                          <span className="text-gray-500">مرحلة التأصيل:</span>
                          <span className="text-emerald-400 font-bold">بث معتمد ومقبول</span>
                        </div>
                        <div className="flex justify-between font-mono">
                          <span className="text-gray-500">الملف الفعلي لقاضي النزاع:</span>
                          <span className="text-white">{selectedEvidence.file}</span>
                        </div>
                        <div className="border-t border-white/5 pt-1.5 font-mono text-[8px] text-gray-400 break-all leading-normal">
                          SHA256: {selectedEvidence.hash}
                        </div>
                      </div>
                    </div>
                  )}

                  {/* 5. Violation decision details */}
                  {activeBottomSheet === "violation_details" && selectedViolation && (
                    <div className="space-y-3.5 text-right text-xs pt-1">
                      <div className="bg-black/60 p-3.5 rounded-xl border border-red-500/20 space-y-2">
                        <span className="text-[10px] text-red-400 font-black block">عقوبة الفحص: {selectedViolation.id}</span>
                        <h4 className="text-sm font-black text-white">{selectedViolation.title}</h4>
                        <p className="leading-relaxed text-gray-300">{selectedViolation.desc}</p>
                      </div>

                      <div className="bg-black/40 p-3 rounded-xl border border-white/5 space-y-1.5 text-[10px]">
                        <div className="flex justify-between">
                          <span className="text-gray-400">تاريخ التسجيل الميداني:</span>
                          <span className="text-white font-bold">{selectedViolation.date}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-gray-400">القيمة والتعويض:</span>
                          <span className="text-red-400 font-bold">{selectedViolation.amount}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-gray-400">رقم تتبع القرار:</span>
                          <span className="text-[#D4AF37] font-mono">{selectedViolation.trackingId}</span>
                        </div>
                      </div>

                      {selectedViolation.status.includes("مفتوحة") && (
                        <button
                          type="button"
                          onClick={() => {
                            setSelectedVioObjId(selectedViolation.id);
                            setActiveBottomSheet("appeal_ai_wizard");
                          }}
                          className="w-full py-2.5 bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs rounded-xl flex items-center justify-center gap-1.5 cursor-pointer transition shadow"
                        >
                          <FilePen className="w-4 h-4" />
                          <span>صياغة عريضة التماس مسببة الآن</span>
                        </button>
                      )}
                    </div>
                  )}

                  {/* 6. LEXI AI Objection Generator Drawer (Step-by-Step wizard with Canvas Signature) */}
                  {activeBottomSheet === "appeal_ai_wizard" && (
                    <div className="space-y-3.5 text-right pt-1 pb-4">
                      <div className="bg-[#0b0c15] border border-blue-500/25 p-3 rounded-xl space-y-1.5">
                        <span className="text-[9.5px] text-blue-400 font-black uppercase tracking-wider block">LEXI AI MOCK PREVIEW</span>
                        <p className="text-[10.5px] text-gray-300 leading-relaxed font-bold">
                          المحامي القانوني الذكي المساعد يقوم بإنشاء عريضة اعتراض لعدم التقيد بـ GPS بناء على رصيدك الماسي الخالي من المخالفات في الـ 180 يوماً الماضية.
                        </p>
                      </div>

                      <div>
                        <label className="block text-[10px] text-gray-400 mb-1 font-extrabold">المبررات والأسباب المشروعة التوضيحية لعدم الالتزام:</label>
                        <textarea
                          rows={2.5}
                          value={appealReasonText}
                          onChange={e => setAppealReasonText(e.target.value)}
                          placeholder="مثال: تعطل خط الألياف البصرية المزود للحي بالكامل مع شهادة تأكيد STC الملحقة بالأدلة."
                          className="w-full bg-black border border-white/10 rounded-xl p-2.5 text-xs text-white resize-none focus:border-blue-500 focus:outline-none"
                        />
                      </div>

                      {/* AI Document draft generator trigger */}
                      <button
                        type="button"
                        onClick={generateLexiObjectionDoc}
                        disabled={isGeneratingLexi}
                        className="w-full py-2 bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-xs rounded-xl flex items-center justify-center gap-1.5 cursor-pointer shadow-md disabled:bg-white/10"
                      >
                        <Sparkles className="w-4 h-4 text-blue-300" />
                        <span>{isGeneratingLexi ? "جاري تحرير اللائحة بدقة الحوكمة..." : "توليد الصيغة السيادية بالذكاء الاصطناعي ✨"}</span>
                      </button>

                      {/* Interactive PDF Draft code output block */}
                      {lexiDraftCode && (
                        <div className="space-y-3">
                          <label className="block text-[10px] text-[#D4AF37] font-black">[مسودة عريضة الدفاع الآلية]:</label>
                          <div className="bg-black/95 border border-[#D4AF37]/35 rounded-xl p-3 text-[10.5px] text-slate-100 font-mono leading-relaxed max-h-[170px] overflow-y-auto custom-scrollbar text-right leading-relaxed whitespace-pre-wrap">
                            {lexiDraftCode}
                          </div>

                          {/* Signature Digital Canvas Block */}
                          <div className="border border-white/10 rounded-xl p-2.5 bg-black/50 space-y-2">
                            <span className="text-[9px] text-gray-400 font-bold block">وقع بأصبعك هنا لتأكيد البصمة واعتماد اللائحة رقمياً:</span>
                            
                            <canvas
                              ref={canvasRef}
                              width={320}
                              height={100}
                              onMouseDown={initDrawing}
                              onMouseMove={performDrawing}
                              onMouseUp={endDrawing}
                              onMouseLeave={endDrawing}
                              onTouchStart={initDrawing}
                              onTouchMove={performDrawing}
                              onTouchEnd={endDrawing}
                              className="w-full h-[100px] bg-white rounded-lg cursor-crosshair border border-[#D4AF37]/30"
                            />

                            <div className="flex justify-between items-center pt-1">
                              <span className="text-[8px] text-gray-500 font-mono">C9 DIGI-SIGNATURE BLOCK</span>
                              <button
                                type="button"
                                onClick={resetSignature}
                                className="px-2 py-0.5 bg-white/5 hover:bg-white/10 text-red-400 text-[8.5px] rounded border border-red-500/25 cursor-pointer font-bold"
                              >
                                إزالة التوقيع
                              </button>
                            </div>
                          </div>

                          <button
                            type="button"
                            onClick={publishObjectionFinal}
                            disabled={!signatureData}
                            className={`w-full py-2.5 text-xs font-black rounded-xl transition ${
                              signatureData
                                ? "bg-[#D4AF37] hover:bg-amber-600 text-black shadow-lg cursor-pointer"
                                : "bg-white/10 text-gray-500 cursor-not-allowed"
                            }`}
                          >
                            <span>تصديق الاعتراض ونشره في السجل العالي ⚖️</span>
                          </button>
                        </div>
                      )}
                    </div>
                  )}

                </motion.div>
              </div>
            )}
          </AnimatePresence>

        </div>
      </div>
    </div>
  );
}
