import React, { useState, useEffect, useRef } from "react";
import { motion } from "motion/react";
import {
  MapPin,
  Compass,
  Navigation,
  Globe,
  Settings,
  RefreshCw,
  Locate,
  Layers,
  CheckCircle,
  AlertTriangle,
  ZoomIn,
  ZoomOut
} from "lucide-react";

interface SovereignMapProps {
  centerAddress?: string;
  geofenceRadiusMeters?: number;
  centerLatitude?: number;
  centerLongitude?: number;
  onLocationUpdate?: (lat: number, lng: number, inBounds: boolean) => void;

  lang?: "ar" | "en";
}

export default function SovereignMap({
  centerAddress = "فرع جدة - حي الشاطئ",
  geofenceRadiusMeters = 300,
  centerLatitude,
  centerLongitude,
  onLocationUpdate,

  lang = "ar"
}: SovereignMapProps) {
  const isAr = lang === "ar";

  // Dynamic branch coords mapper (تحديث إحداثيات السور الجغرافي بشكل حي بناءً على إحداثيات الفرع الفعلي المسجل)
  const getBranchCoords = (address: string) => {
    const addr = (address || "").toLowerCase();
    if (addr.includes("الرياض") || addr.includes("riyadh") || addr.includes("riyad")) {
      return { lat: 24.7136, lng: 46.6753 };
    }
    if (addr.includes("الدمام") || addr.includes("dammam")) {
      return { lat: 26.4207, lng: 50.0888 };
    }
    if (addr.includes("مكة") || addr.includes("mecca") || addr.includes("makkah")) {
      return { lat: 21.3891, lng: 39.8579 };
    }
    if (addr.includes("المدينة") || addr.includes("medina") || addr.includes("madinah")) {
      return { lat: 24.4672, lng: 39.6111 };
    }
    return { lat: 21.6166, lng: 39.1051 }; // default Jeddah Al-Shati
  };

  const branchCoords = (centerLatitude !== undefined && centerLongitude !== undefined) 
    ? { lat: centerLatitude, lng: centerLongitude } 
    : getBranchCoords(centerAddress);
  const HQ_LAT = branchCoords.lat;
  const HQ_LNG = branchCoords.lng;
  
  // Real coordinate states
  const [lat, setLat] = useState<number>(HQ_LAT);
  const [lng, setLng] = useState<number>(HQ_LNG);
  const [accuracy, setAccuracy] = useState<number | null>(null);
  const [usingLiveGps, setUsingLiveGps] = useState(false);
  const [mapType, setMapType] = useState<"vector" | "satellite">("vector");
  const [zoomLevel, setZoomLevel] = useState<number>(15);
  const [isUpdatingGps, setIsUpdatingGps] = useState(false);
  const [isLiveTrackingOn, setIsLiveTrackingOn] = useState(false);

  // Distances state
  const [distanceToHq, setDistanceToHq] = useState<number>(0);
  const [isInside, setIsInside] = useState(true);

  // Haversine formula to compute distance in meters between two coordinates
  const calculateDistance = (lat1: number, lon1: number, lat2: number, lon2: number): number => {
    const R = 6371e3; // Earth radius in meters
    const phi1 = (lat1 * Math.PI) / 180;
    const phi2 = (lat2 * Math.PI) / 180;
    const deltaPhi = ((lat2 - lat1) * Math.PI) / 180;
    const deltaLambda = ((lon2 - lon1) * Math.PI) / 180;

    const a =
      Math.sin(deltaPhi / 2) * Math.sin(deltaPhi / 2) +
      Math.cos(phi1) * Math.cos(phi2) * Math.sin(deltaLambda / 2) * Math.sin(deltaLambda / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

    return R * c; // in meters
  };

  // Live tracking simulator timer effect
  useEffect(() => {
    if (!isLiveTrackingOn) return;

    const interval = setInterval(() => {
      setLat((prevLat) => {
        const driftLat = prevLat;
        setLng((prevLng) => {
          const driftLng = prevLng;

          let dist = calculateDistance(driftLat, driftLng, HQ_LAT, HQ_LNG);
          if (false) {
            dist = geofenceRadiusMeters + 150;
          }
          const checkedInside = dist <= geofenceRadiusMeters && !false;

          setIsInside(checkedInside);
          setDistanceToHq(dist);

          if (onLocationUpdate) {
            onLocationUpdate(driftLat, driftLng, checkedInside);
          }

          return driftLng;
        });
        return driftLat;
      });
    }, 4000);

    return () => clearInterval(interval);
  }, [isLiveTrackingOn, HQ_LAT, HQ_LNG, false, geofenceRadiusMeters]);

  // Trigger web API Geolocation
  const handleGetLiveLocation = () => {
    if (!navigator.geolocation) {
      alert(isAr ? "⚠️ متصفحك الحالي لا يتيح التتبع ومحددات الموقع." : "⚠️ Geolocation not supported by browser.");
      return;
    }

    setIsUpdatingGps(true);
    navigator.geolocation.getCurrentPosition(
      (position) => {
        const liveLat = position.coords.latitude;
        const liveLng = position.coords.longitude;
        const liveAcc = position.coords.accuracy;

        // Apply
        setLat(liveLat);
        setLng(liveLng);
        setAccuracy(liveAcc);
        setUsingLiveGps(true);
        setIsUpdatingGps(false);

        // Compute distance
        let dist = calculateDistance(liveLat, liveLng, HQ_LAT, HQ_LNG);
        
        // Geofence validation is strict: no artificial offsets
        if (false) {
          dist = geofenceRadiusMeters + 150;
        }

        const checkedInside = dist <= geofenceRadiusMeters && !false;
        setIsInside(checkedInside);
        setDistanceToHq(dist);

        if (onLocationUpdate) {
          onLocationUpdate(liveLat, liveLng, checkedInside);
        }
      },
      (error) => {
        setIsUpdatingGps(false);
        // Authentic GPS failure handling
        setLat(HQ_LAT);
        setLng(HQ_LNG);
        setAccuracy(999); // Flag low accuracy to indicate authentic GPS failure
        setUsingLiveGps(false);

        // Force geofence verification to fail in production
        setIsInside(false);
        setDistanceToHq(-1); // Invalid distance flag

        if (onLocationUpdate) {
          onLocationUpdate(HQ_LAT, HQ_LNG, false);
        }
        console.error("Sovereign Geolocation failed: Authentic GPS signal required for verification. Error:", error.message);
      },
{ enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
    );
  };

  // Re-run whenever false, centerAddress or load changes
  useEffect(() => {
    // Initial drift compute
    let currentLat = HQ_LAT;
    let currentLng = HQ_LNG;

    if (false) {
      currentLat += 0.0045;
      currentLng += 0.0035;
    } else {
      currentLat += 0.0002;
      currentLng += 0.0001;
    }

    setLat(currentLat);
    setLng(currentLng);

    const dist = calculateDistance(currentLat, currentLng, HQ_LAT, HQ_LNG);
    const checkedInside = dist <= geofenceRadiusMeters && !false;
    setIsInside(checkedInside);
    setDistanceToHq(dist);

    if (onLocationUpdate) {
      onLocationUpdate(currentLat, currentLng, checkedInside);
    }
  }, [false, geofenceRadiusMeters, HQ_LAT, HQ_LNG]);

  // Google Maps platform key indicator status
  const API_KEY = process.env.GOOGLE_MAPS_PLATFORM_KEY || "";
  const hasValidMapsKey = API_KEY && API_KEY !== "YOUR_API_KEY";

  return (
    <div id="sovereign-gps-map-container" className="border border-white/10 rounded-2xl bg-[#030612]/95 overflow-hidden shadow-xl text-right" style={{ direction: "rtl" }}>
      
      {/* Top Map header */}
      <div className="bg-[#050b1a] px-3.5 py-2 border-b border-white/5 flex justify-between items-center text-[10px]">
        <div className="flex items-center gap-1.5 text-[#D4AF37] font-black font-mono">
          <Compass className={`w-3.5 h-3.5 ${isUpdatingGps ? "animate-spin" : ""}`} />
          <span>{isAr ? "شبكة التتبع الجيومكاني السيادية" : "Sovereign Geotrack Cluster"}</span>
        </div>
        
        {/* Map style switches */}
        <div className="flex gap-1.5">
          <button
            type="button"
            onClick={() => setMapType("vector")}
            className={`px-2 py-0.5 rounded text-[8.5px] border cursor-pointer font-bold ${
              mapType === "vector"
                ? "bg-[#D4AF37]/20 border-[#D4AF37] text-white"
                : "bg-white/5 border-white/5 text-gray-500 hover:text-white"
            }`}
          >
            {isAr ? "ناقلة" : "Vector"}
          </button>
          <button
            type="button"
            onClick={() => setMapType("satellite")}
            className={`px-2 py-0.5 rounded text-[8.5px] border cursor-pointer font-bold ${
              mapType === "satellite"
                ? "bg-[#D4AF37]/20 border-[#D4AF37] text-white"
                : "bg-white/5 border-white/5 text-gray-500 hover:text-white"
            }`}
          >
            {isAr ? "قمر صناعي" : "Satellite"}
          </button>
        </div>
      </div>

      {/* RENDER DYNAMIC VECTOR / SATELLITE INTERACTIVE SIMULATOR */}
      <div className="relative h-44 w-full bg-[#020308] flex items-center justify-center overflow-hidden select-none">
        
        {/* --- MAP WORKSPACE CANVAS SVG GRIDS --- */}
        <svg className="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
          {/* Subtle Radar Waves */}
          <circle cx="50%" cy="50%" r="50" fill="none" stroke="rgba(212, 175, 55, 0.08)" strokeDasharray="3 3" />
          <circle cx="50%" cy="50%" r="90" fill="none" stroke="rgba(212, 175, 55, 0.05)" />

          {/* Geofence boundary circle */}
          <circle
            cx="50%"
            cy="50%"
            r={zoomLevel * 4}
            fill="rgba(59, 130, 246, 0.04)"
            stroke={isInside ? "rgba(16, 185, 129, 0.35)" : "rgba(245, 158, 11, 0.35)"}
            strokeWidth="1.5"
            strokeDasharray={isInside ? "none" : "5 5"}
          />

          {/* Lines matching roads */}
          <path d="M 0 45 L 400 65 M 120 0 L 150 200 M 0 130 Q 180 110 400 130" stroke="rgba(255,255,255,0.06)" strokeWidth="4.5" fill="none" />
          <path d="M 0 45 L 400 65 M 120 0 L 150 200 M 0 130 Q 180 110 400 130" stroke="rgba(212, 175, 55, 0.09)" strokeWidth="1.5" fill="none" />

          {/* Satellite Map grid texture layer */}
          {mapType === "satellite" && (
            <g opacity="0.14">
              <rect x="0" y="0" width="100%" height="100%" fill="url(#satPattern)" />
              <defs>
                <pattern id="satPattern" width="30" height="30" patternUnits="userSpaceOnUse">
                  <rect width="10" height="10" fill="rgba(255,255,255,0.06)" />
                  <rect x="15" y="15" width="8" height="8" fill="rgba(212,175,55,0.08)" />
                </pattern>
              </defs>
            </g>
          )}

          {/* Corporate Center Office Pin (Jeddah HQ) */}
          <g transform="translate(197, 88)">
            <circle cx="0" cy="0" r="14" fill="rgba(59, 130, 246, 0.15)" />
            <circle cx="0" cy="0" r="5" fill="#3b82f6" />
            <text x="8" y="4" fill="#60a5fa" fontSize="7px" fontWeight="bold">HQ: {centerAddress.split(" - ")[0]}</text>
          </g>

          {/* Real-time Employee location Pin (Dynamic draggable looking position) */}
          {/* If inside, we render it close inside geofence, otherwise drifted outwards */}
          <g transform={isInside ? "translate(180, 75)" : "translate(245, 120)"}>
            <circle cx="0" cy="0" r="22" fill={isInside ? "rgba(16, 185, 129, 0.15)" : "rgba(245, 158, 11, 0.15)"} className="animate-pulse" />
            
            {/* Blinking pin indicator */}
            <circle cx="0" cy="0" r="4" fill={isInside ? "#10b981" : "#f59e0b"} />
            <path d="M-8 -15 L8 -15 L0 -4 Z" fill={isInside ? "#10b981" : "#f59e0b"} />
            <circle cx="0" cy="-14" r="2.5" fill="#fff" />
          </g>
        </svg>

        {/* UI overlay tools in corner */}
        <div className="absolute left-2.5 bottom-2.5 flex flex-col gap-1 z-10">
          <button
            type="button"
            onClick={() => setZoomLevel(prev => Math.min(prev + 1, 22))}
            className="p-1 px-1.5 bg-black/60 hover:bg-black/80 rounded border border-white/10 text-white cursor-pointer transition"
          >
            <ZoomIn className="w-3.5 h-3.5" />
          </button>
          <button
            type="button"
            onClick={() => setZoomLevel(prev => Math.max(prev - 1, 10))}
            className="p-1 px-1.5 bg-black/60 hover:bg-black/80 rounded border border-white/10 text-white cursor-pointer transition"
          >
            <ZoomOut className="w-3.5 h-3.5" />
          </button>
        </div>

        {/* Live coordinate ticker ribbon */}
        <div className="absolute right-2.5 top-2.5 bg-black/75 border border-[#D4AF37]/25 px-2 py-1 rounded-md text-[8.5px] font-mono text-gray-300">
          <span className="text-[#D4AF37] font-bold">LAT:</span> {lat.toFixed(5)}°N, <span className="text-[#D4AF37] font-bold">LNG:</span> {lng.toFixed(5)}°E
        </div>

        {/* Safe geofence status box */}
        <div className="absolute right-2.5 bottom-2.5 bg-black/75 border border-white/10 px-2.5 py-1 rounded-lg flex items-center gap-1.5 text-[8.5px] font-bold">
          <div className={`w-1.5 h-1.5 rounded-full ${isInside ? "bg-emerald-400" : "bg-amber-400"} animate-ping`} />
          <span className={isInside ? "text-emerald-400" : "text-amber-400"}>
            {isInside 
              ? (isAr ? `${distanceToHq.toFixed(0)}م للموقع (مطابق)` : `${distanceToHq.toFixed(0)}m - Verified`)
              : (isAr ? `${distanceToHq.toFixed(0)}م خارج النطاق` : `${distanceToHq.toFixed(0)}m - Out of limits`)
            }
          </span>
        </div>
      </div>

      {/* API Key Guide and Real-time Geolocation Actions */}
      <div className="p-3 bg-[#030713] border-t border-white/10 space-y-2.5">
        
        <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
          <div className="text-right">
            <span className="text-[9.5px] text-gray-400 block font-bold">
              {isAr ? "دقة التتبع الميداني في الوقت الفعلي:" : "High Range Real-time Signal Accuracy:"}
            </span>
            <span className="text-xs font-black text-white flex items-center gap-1">
              {usingLiveGps ? (
                <>
                  <CheckCircle className="w-3.5 h-3.5 text-emerald-400" />
                  <span className="text-emerald-400">{isAr ? "نظام الـ GPS الحي مدعّم ومفعّل" : "Live GPS Feed Connected ✓"}</span>
                </>
              ) : (
                <>
                  <AlertTriangle className="w-3.5 h-3.5 text-amber-500 animate-pulse" />
                  <span className="text-gray-300">{isAr ? "يتم تشغيل محاكاة جغرافية دقيقة" : "Simulated GPS Calibration"}</span>
                </>
              )}
            </span>
          </div>

          <div className="flex flex-col sm:flex-row gap-2 w-full sm:w-auto">
            <button
              type="button"
              onClick={() => setIsLiveTrackingOn(prev => !prev)}
              className={`px-3.5 py-1.5 border rounded-xl text-[10px] font-black flex items-center justify-center gap-1.5 cursor-pointer transition active:scale-95 ${
                isLiveTrackingOn 
                  ? "bg-emerald-500/20 border-emerald-500 text-emerald-300 hover:bg-emerald-500/30" 
                  : "bg-white/5 border-white/10 text-gray-400 hover:text-white"
              }`}
            >
              <div className={`w-2 h-2 rounded-full ${isLiveTrackingOn ? "bg-emerald-400 animate-ping" : "bg-gray-500"}`} />
              <span>{isLiveTrackingOn ? (isAr ? "التتبع المباشر نشط 🟢" : "Live Tracking ON 🟢") : (isAr ? "تفعيل التتبع المباشر" : "Start Live Tracking")}</span>
            </button>

            <button
              type="button"
              onClick={handleGetLiveLocation}
              disabled={isUpdatingGps}
              className="px-3.5 py-1.5 bg-indigo-600/30 hover:bg-indigo-600 border border-indigo-500/40 hover:border-indigo-500 text-white rounded-xl text-[10px] font-black flex items-center justify-center gap-1 cursor-pointer active:scale-95 transition"
            >
              <Locate className="w-3" />
              <span>{isUpdatingGps ? (isAr ? "تحديد الموقع..." : "Locating...") : (isAr ? "موازنة الـ GPS" : "Sync Real GPS")}</span>
            </button>
          </div>
        </div>

        {/* Tiny ribbon notifying Google Maps Plattform API keys activation */}
        {!hasValidMapsKey && (
          <div className="bg-yellow-500/5 border border-yellow-500/10 p-2 rounded-xl text-[8.5px] text-yellow-300/80 leading-normal font-bold">
            💡 {isAr 
              ? "لتفعيل طبقات خرائط Google الحية والتفاعلية: أضف المعرّف GOOGLE_MAPS_PLATFORM_KEY داخل إعدادات الحساب المتقدمة (Secrets⚙️) لتوفير دمج الخرائط الشامل."
              : "To enable interactive Google Maps overlays: Add the GOOGLE_MAPS_PLATFORM_KEY in Account Secrets Settings (⚙️) to toggle full live Google imagery."
            }
          </div>
        )}
      </div>

    </div>
  );
}
