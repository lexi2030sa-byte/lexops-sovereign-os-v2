export const mapSectorToActivityId = (sector: string, entityId?: string): string => {
  const norm = (sector || "").toLowerCase().trim();
  
  // 🎯 المطابقة الدقيقة حسب القطاع الرسمي
  if (norm.includes("أغذية") || norm.includes("ضيافة") || norm.includes("restaurant") || norm.includes("food") || norm.includes("catering") || norm.includes("مطعم")) return "restaurants";
  if (norm.includes("مقهى") || norm.includes("cafe") || norm.includes("coffee") || norm.includes("كافيه")) return "cafes";
  if (norm.includes("وجبات") || norm.includes("fast") || norm.includes("takeaway")) return "fastfood";
  if (norm.includes("عصير") || norm.includes("juice")) return "juices";
  if (norm.includes("مخبز") || norm.includes("bakery") || norm.includes("baker")) return "bakeries";
  if (norm.includes("لوجست") || norm.includes("نقل") || norm.includes("transport") || norm.includes("logistic") || norm.includes("شحن")) return "logistics_transport";
  if (norm.includes("مقاول") || norm.includes("إنشاء") || norm.includes("بناء") || norm.includes("contract") || norm.includes("construction")) return "construction";
  if (norm.includes("تقنية") || norm.includes("برمج") || norm.includes("حاسب") || norm.includes("software") || norm.includes("it ") || norm.includes("tech")) return "it_services";
  if (norm.includes("تجزئ") || norm.includes("تموين") || norm.includes("retail") || norm.includes("متاجر")) return "general_retail";
  if (norm.includes("صحة") || norm.includes("طب") || norm.includes("health") || norm.includes("medical")) return "healthcare";
  if (norm.includes("تعليم") || norm.includes("تدريب") || norm.includes("education") || norm.includes("training")) return "education";
  
  // 🔴 عدم التطابق = نشاط غير معروف
  console.warn(`[Sovereign Activity Mapper] ⚠️ نشاط غير معروف للمنشأة ${entityId || "غير محددة"}: "${sector}"`);
  return "unclassified_entity";
};

