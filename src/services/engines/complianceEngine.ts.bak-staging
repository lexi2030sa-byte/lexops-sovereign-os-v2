import * as admin from "firebase-admin";
import { SovereignEngine, EngineResult, EngineContext, generateC9Hash } from "./types";

export interface ComplianceMetrics {
  score: number;
  status: string;
  totalCitations: number;
  pendingCitations: number;
  resolvedCitations: number;
  totalAppeals: number;
  pendingAppeals: number;
  approvedAppeals: number;
  rejectedAppeals: number;
  riskLevel: string;
}

const getDb = () => admin.firestore();

/**
 * استعلام المخالفات والاعتراضات الحقيقية للكيان وحساب معدلات الامتثال السيادية حياً
 * (الدالة الأصلية — محفوظة للتوافقية العكسية)
 */
export async function getComplianceMetrics(entityId?: string): Promise<ComplianceMetrics> {
  const activeId = entityId || "7070701234";
  const db = getDb();

  const citationsSnapshot = await db.collection("citations")
    .where("entityId", "==", activeId)
    .get();

  const citations = citationsSnapshot.docs.map(doc => doc.data());
  const totalCitations = citations.length;
  const pendingCitations = citations.filter(c => c.status === "PENDING" || !c.status).length;
  const resolvedCitations = totalCitations - pendingCitations;

  const appealsSnapshot = await db.collection("appeals")
    .where("entityId", "==", activeId)
    .get();

  const appeals = appealsSnapshot.docs.map(doc => doc.data());
  const totalAppeals = appeals.length;
  const pendingAppeals = appeals.filter(a => a.status === "PENDING" || !a.status).length;
  const approvedAppeals = appeals.filter(a => a.status === "APPROVED" || a.status === "ACCEPTED").length;
  const rejectedAppeals = totalAppeals - pendingAppeals - approvedAppeals;

  let score = 100 - (pendingCitations * 10);
  if (score < 0) score = 0;
  if (score > 100) score = 100;

  let status = "EXCELLENT";
  let riskLevel = "LOW";

  if (score < 50) { status = "CRITICAL"; riskLevel = "CRITICAL"; }
  else if (score < 75) { status = "WARNING"; riskLevel = "MEDIUM"; }
  else if (score < 90) { status = "GOOD"; riskLevel = "LOW"; }

  return {
    score,
    status,
    totalCitations,
    pendingCitations,
    resolvedCitations,
    totalAppeals,
    pendingAppeals,
    approvedAppeals,
    rejectedAppeals,
    riskLevel
  };
}

/**
 * جلب حالة الامتثال الفعلية للكيان
 * (الدالة الأصلية — محفوظة للتوافقية العكسية)
 */
export async function getComplianceStatus(entityId?: string) {
  const metrics = await getComplianceMetrics(entityId);
  return {
    score: metrics.score,
    status: metrics.status,
    riskLevel: metrics.riskLevel,
    updatedAt: new Date()
  };
}

/**
 * التنبؤ بمخاطر الامتثال بناءً على مؤشرات المخالفات والاعتراضات الحقيقية
 * (الدالة الأصلية — محفوظة للتوافقية العكسية)
 */
export async function predictComplianceRisks(entityId?: string) {
  const metrics = await getComplianceMetrics(entityId);
  let riskFactors: string[] = [];
  if (metrics.pendingCitations > 0) {
    riskFactors.push(`مخالفات معلقة: هناك عدد ${metrics.pendingCitations} مخالفة تشغيلية تتطلب المعالجة الفورية.`);
  }
  if (metrics.pendingAppeals > 0) {
    riskFactors.push(`اعتراضات معلقة: هناك عدد ${metrics.pendingAppeals} اعتراض قانوني قيد المراجعة والتدقيق.`);
  }
  if (metrics.score < 80) {
    riskFactors.push("تجاوز حد الأمان: انخفض مؤشر الامتثال الإجمالي دون العتبة السيادية الآمنة 80%.");
  }

  return {
    entityId: entityId || "7070701234",
    riskLevel: metrics.riskLevel,
    riskScore: 100 - metrics.score,
    riskFactors: riskFactors.length > 0 ? riskFactors : ["لا توجد مؤشرات مخاطر نشطة. النظام ممتثل بالكامل."],
    predictionDate: new Date()
  };
}

/**
 * حساب قيمة الامتثال الرقمية
 * (الدالة الأصلية — محفوظة للتوافقية العكسية)
 */
export async function calculateComplianceScore(entityId?: string): Promise<number> {
  const metrics = await getComplianceMetrics(entityId);
  return metrics.score;
}

/**
 * المحرك السيادي الموحد لمطابقة S9 Ledger
 */
export const complianceEngine: SovereignEngine = {
  id: "S8-2026",
  name: "Sovereign Compliance Engine",
  version: "2026.1.0",

  async execute(payload: any, ctx: EngineContext): Promise<EngineResult> {
    const ts = new Date().toISOString();
    try {
      const metrics = await getComplianceMetrics(ctx.entityId);
      return {
        success: true,
        data: metrics,
        timestamp: ts,
        engineId: this.id,
        c9Hash: generateC9Hash(this.id, payload, ts)
      };
    } catch (err: any) {
      return { success: false, error: err.message, timestamp: ts, engineId: this.id };
    }
  },

  async healthCheck() {
    try {
      const db = admin.firestore();
      await db.collection("citations").limit(1).get();
      return { status: "healthy", details: "S8 متصل بنجاح وجاهز لتقييم الامتثال" };
    } catch (err: any) {
      return { status: "down", details: `S8 معطل: ${err.message}` };
    }
  }
};

export default complianceEngine;
