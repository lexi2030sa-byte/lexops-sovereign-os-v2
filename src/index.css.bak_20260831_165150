@import "tailwindcss";

/* ==========================================
   1. نظام الألوان والخطوط القيادي (Sovereign Theme)
   Project ID: lexops-prod-2026-sa
   ========================================== */
:root {
  /* ألوان الخلفيات والمساحات */
  --bg-main-body:     #0b132b;
  --bg-cards-panels:  #1c2541;
  --bg-inner-cards:   #0e1a38;

  /* ألوان النصوص والخطوط */
  --color-headings:   #ffffff;
  --color-subheadings: #6fffe9;
  --color-body-text:   #e0e1dd;
  --color-muted-text:  #a3cef1;

  /* ألوان الحواف والتأثيرات */
  --border-color:     #3a506b;
  --color-alert-badge: #f85149;
  --color-focus-accent: #5bc0be;
}

body {
  background-color: var(--bg-main-body) !important;
  color: var(--color-body-text) !important;
  font-family: 'Tajawal', 'Segoe UI', system-ui, sans-serif;
  margin: 0;
  padding: 0;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

h1, h2, .main-title {
  color: var(--color-headings) !important;
  font-weight: 700;
}

h3, h4, .card-title {
  color: var(--color-subheadings) !important;
  font-weight: 600;
}

p, .body-text {
  color: var(--color-body-text) !important;
  line-height: 1.6;
}

.muted-link, .secondary-label {
  color: var(--color-muted-text);
  text-decoration: none;
}

.panel, .card, div[class*="bg-"] {
  border-color: var(--border-color);
}

.inner-card {
  background-color: var(--bg-inner-cards) !important;
  border: 1px solid rgba(58, 80, 107, 0.5) !important;
  border-radius: 6px;
  padding: 15px;
}

.alert-badge {
  background-color: var(--color-alert-badge) !important;
  color: #ffffff !important;
  padding: 4px 10px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: bold;
}

.featured-card {
  border-left: 4px solid var(--color-focus-accent) !important;
}

/* ==========================================
   2. الخلفية المتحركة (Animated Sovereign Background)
   ========================================== */
.sovereign-bg-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
  background: 
    linear-gradient(rgba(11, 19, 43, 0.9), rgba(11, 19, 43, 0.95)),
    radial-gradient(circle at 50% 50%, rgba(28, 37, 65, 0.5), var(--bg-main-body));
}

.sovereign-bg-overlay::before {
  content: "";
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background-image: 
    linear-gradient(to right, rgba(111, 255, 233, 0.03) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(111, 255, 233, 0.03) 1px, transparent 1px);
  background-size: 40px 40px;
  transform: perspective(500px) rotateX(60deg);
  animation: gridMove 25s linear infinite;
}

.sovereign-bg-overlay::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    transparent 50%,
    rgba(111, 255, 233, 0.04) 51%,
    rgba(111, 255, 233, 0.08) 52%,
    transparent 53%
  );
  background-size: 100% 12px;
  animation: scanlineMove 10s linear infinite;
}

@keyframes gridMove {
  0% { transform: perspective(500px) rotateX(60deg) translateY(0); }
  100% { transform: perspective(500px) rotateX(60deg) translateY(40px); }
}

@keyframes scanlineMove {
  0% { background-position: 0 0; }
  100% { background-position: 0 100%; }
}
