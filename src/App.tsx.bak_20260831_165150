      tag = "سيادي";
    } else if (
      textToClassify.includes("قرار") || 
      textToClassify.includes("توقيع") || 
      textToClassify.includes("مخالفة") || 
      textToClassify.includes("اعتراض") || 
      textToClassify.includes("تحقيق") || 
      textToClassify.includes("تظلم") || 
      textToClassify.includes("قانوني") || 
      textToClassify.includes("دفوع") || 
      textToClassify.includes("appeal") || 
      textToClassify.includes("citation") || 
      textToClassify.includes("objection") || 
      textToClassify.includes("investigation")
    ) {
