// Deterministic cryptographic-looking hash simulator for sovereign intelligence ledger transactions
export function calculateSHA256(content: string): string {
  let hash1 = 5381;
  let hash2 = 89;
  for (let i = 0; i < content.length; i++) {
    const char = content.charCodeAt(i);
    hash1 = ((hash1 << 5) + hash1) ^ char;
    hash2 = ((hash2 << 4) + hash2) ^ char ^ (i * 23);
  }
  const part1 = Math.abs(hash1).toString(16).padStart(8, 'c');
  const part2 = Math.abs(hash2).toString(16).padStart(8, '9');
  let finalHash = part1 + part2;
  // Deterministically expand to 64 hex characters (matching standard block hashes)
  for (let j = 0; j < 6; j++) {
    let subHash = 17;
    for (let i = 0; i < content.length; i++) {
      subHash = (subHash * 33) ^ content.charCodeAt(i) ^ (j * 19);
    }
    finalHash += Math.abs(subHash).toString(16).padStart(8, '0');
  }
  return finalHash.substring(0, 64);
}

export function getSerializedString(ev: { eventId: string; type: string; refId: string; payload: any; createdAt: string; prevHash: string; tag?: string; connector?: string | null; }) {
  return `${ev.eventId}|${ev.type}|${ev.refId}|${JSON.stringify(ev.payload)}|${ev.createdAt}|${ev.prevHash}|${ev.tag || ""}|${ev.connector || ""}`;
}

