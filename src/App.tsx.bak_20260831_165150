  const handleVerifyLedger = () => {
    let isChainValid = true;
    for (let i = 0; i < c9Events.length; i++) {
       const ev = c9Events[i];
       
       // 1. Recalculate hash of current block
       const inputForHash = {
         eventId: ev.eventId,
         type: ev.type,
         refId: ev.refId,
         payload: ev.payload,
         createdAt: ev.createdAt,
         prevHash: ev.prevHash
       };
       const computed = calculateSHA256(getSerializedString(inputForHash));
       
       // Compare computed hash with stored hash
       if (computed !== ev.hash) {
         isChainValid = false;
         break;
       }
       
       // 2. Checked from idx 1 onwards, if ev.prevHash matches the preceding block's hash
       if (i > 0) {
         const precedingBlock = c9Events[i - 1];
         if (ev.prevHash !== precedingBlock.hash) {
           isChainValid = false;
           break;
         }
       }
    }
    
    if (isChainValid) {
      setVerificationStatus("valid");
    } else {
      setVerificationStatus("invalid");
    }
  };

