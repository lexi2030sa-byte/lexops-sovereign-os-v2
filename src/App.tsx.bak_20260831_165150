    const textToClassify = `${type} ${refId} ${payloadStr}`.toLowerCase();

    if (
      textToClassify.includes("سيادي") || 
      textToClassify.includes("حارس البوابة") || 
      textToClassify.includes("تأسيس") || 
      textToClassify.includes("sovereign") || 
      textToClassify.includes("genesis") || 
      textToClassify.includes("gatekeeper") || 
      textToClassify.includes("سجل تجاري")
