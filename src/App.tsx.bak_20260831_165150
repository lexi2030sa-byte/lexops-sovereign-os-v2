    } else {
      tag = "تشغيلي";
    }

    // 3. CONNECTOR RELATION (Foreign Key): Associate the log with Qiwa, Balady, ZATCA, GOSI, or Salamah
    let connector: "Qiwa" | "Balady" | "ZATCA" | "GOSI" | "Salamah" | null = null;
    if (
      textToClassify.includes("بلدي") || 
      textToClassify.includes("بلدية") || 
      textToClassify.includes("أمانة") || 
      textToClassify.includes("رخصة فرع") || 
      textToClassify.includes("تأسيس فرع") || 
      textToClassify.includes("موقع") || 
      textToClassify.includes("جغرافي") || 
      textToClassify.includes("balady") || 
      textToClassify.includes("municipality") || 
      textToClassify.includes("gps") || 
      textToClassify.includes("geo")
