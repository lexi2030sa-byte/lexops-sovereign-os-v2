      connector = "Balady";
    } else if (
      textToClassify.includes("زكاة") || 
      textToClassify.includes("دخل") || 
      textToClassify.includes("ضريبة") || 
      textToClassify.includes("فاتورة") || 
      textToClassify.includes("مالي") || 
      textToClassify.includes("دفعة") || 
      textToClassify.includes("سداد") || 
      textToClassify.includes("zatca") || 
      textToClassify.includes("tax") || 
      textToClassify.includes("invoice") || 
      textToClassify.includes("payment") || 
      textToClassify.includes("finance")
    ) {
      connector = "ZATCA";
